@model LoginViewModel
@{
    ViewData["Title"] = "Inloggen";
    Layout = "_Layout";
}

<div class="container mt-5 pt-5">
    <div class="d-flex justify-content-center">
        <div class="card mb-2 mt-2 shadow">
            <div class="card-header">
                <h2>Inloggen</h2>
            </div>
            <form asp-action="Login" asp-controller="Account" method="post">

                <div class="card-body">
                    <div class="d-flex justify-content-end mb-3">
                        <a type="button" class="btn" asp-controller="Home" asp-action="Index">Terug</a>
                    </div>

              
                    <div class="mb-3">
                        <label class="card-text" for="email">Emailadres:</label>
                        <input asp-for="Name" type="email" id="email" class="form-control" placeholder="Voer hier je e-mailadres in" />
                        <span asp-validation-for="Name" class="text-danger"></span>

                    </div>

                    <div class="mb-3">
                        <label class="card-text" for="password">Wachtwoord:</label>
                        <input asp-for="Password" type="password" id="password" class="form-control" placeholder="Voer hier je wachtwoord in" />
                        <span asp-validation-for="Password" class="text-danger"></span>

                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <span>Heb je nog geen account? <a class="account-information" asp-controller="Account" asp-action="Register">Klik hier</a></span>
                        <button class="btn" type="submit">Inloggen</button>
                    </div>
                </div>

            </form>
        </div>
    </div>
</div>
