@{
    ViewData["Title"] = "Aanmelden";
    Layout = "_Layout";
}

<div class="container mt-5 pt-5">
    <div class="d-flex justify-content-center">
        <div class="card mb-2 mt-2 shadow">
            <div class="card-header">
                <h2>Aanmelden</h2>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-end mb-3">
                    <a type="button" class="btn" asp-controller="Home" asp-action="Index">Terug</a>
                </div>

                <h2>Selecteer hier een rol voor het formulier:</h2>
                <ul class="nav nav-tabs">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Account" asp-action="RegisterStudent" role="tab" aria-controls="student-form">
                            Student
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Account" asp-action="RegisterCanteenWorker" role="tab" aria-controls="canteenworker-form">
                            Kantinemedewerker
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
