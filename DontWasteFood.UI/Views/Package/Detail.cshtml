@model PackageViewModel
@{
    ViewData["Title"] = "Details";
    Layout = "_Layout";
}

<partial name="_StudentMenu" />

<div class="container mt-5 pt-5">
    <div class="d-flex justify-content-center">
        <div class="card mb-2 mt-2 shadow">
            <div class="card-header">
                <h2>Details</h2>
            </div>

            <div class="card-body">
                <div class="d-flex justify-content-end mb-3">
                    <a type="button" class="btn" asp-controller="Student" asp-action="Overview">Terug</a>   
                </div>
                <div class="box me-auto ms-auto card-title">
                    <div class="row detail-row mt-2">
                        <div class="col-6 detail-label"><h2>Naam:</h2></div>
                        <div class="col-6 detail-value text-right"><h2>@Model.Name</h2></div>
                    </div>
                </div>

                <div class="details-box mx-auto">
                    <div class="row detail-row mb-1">
                        <div class="col-6 detail-label"><strong>Ophaaldatum:</strong></div>
                        <div class="col-6 detail-value"><p>@Model.DateOfPickUp.ToString("dd-MM-yyyy")</p></div>
                    </div>

                    <div class="row detail-row mb-1">
                        <div class="col-6 detail-label"><strong>Tijd:</strong></div>
                        <div class="col-6 detail-value"><p>@Model.TimeOfPickUp.ToString("HH:mm")</p></div>
                    </div>
                    <div class="row detail-row mb-1">
                        <div class="col-6 detail-label"><strong>Maaltijdtype:</strong></div>
                        <div class="col-6 detail-value"><p>@Model.MealType.ToString().Replace("_", " ")</p></div>
                    </div>
                    <div class="row detail-row mb-1">
                        <div class="col-6 detail-label"><strong>Locatie:</strong></div>
                        <div class="col-6 detail-value"><p>@Model.Location</p></div>
                    </div>
                    <div class="row detail-row mb-1">
                        <div class="col-6 detail-label"><strong>Stad:</strong></div>
                        <div class="col-6 detail-value"><p>@Model.City.ToString().Replace("_", " ")</p></div>
                    </div>
                    <div class="row detail-row mb-1">
                        <div class="col-6 detail-label"><strong>18+ indicatie:</strong></div>
                        <div class="col-6 detail-value"><p>@(Model.Is18Plus ? "Ja" : "Nee")</p></div>
                    </div>
                </div>

                <div class="box mx-auto">
                    <div class="row detail-row mt-2">
                        <div class="col-6 detail-label"><h3>Prijs:</h3></div>
                        <div class="col-6 detail-value text-right"><h3>€ @Model.Price</h3></div>
                    </div>
                </div>

                <div class="box mx-auto">

                        @if (Model.ReservedBy != null)
                        {
                            <div class="row detail-row mt-2">

                            <span><strong>Gereserveerd door: @Model.ReservedBy</strong></span>
                            </div>
                        }
                        else
                        {
                            <div class="row detail-row mt-2 ms-1">
                            <button type="submit" class="btn">Reserveer</button>
                            </div>


                        }
                   
                </div>

                <div class="box me-auto ms-auto card-title">
                    <div class="row detail-row mt-2">
                        <div class="col-6 detail-label"><h2>Producten</h2></div>
                    </div>
                </div>

                <div class="details-box mx-auto">
                    @if (Model.Products != null && Model.Products.Any())
                    {
                        @foreach (var product in Model.Products)
                        {
                            <div class="row detail-row mb-1">
                                <div class="col-md-2">
                                    @if (!string.IsNullOrEmpty(product.Photo))
                                    {
                                        <img class="img-fluid rounded-start" src="@product.Photo" />
                                    }
                                    else
                                    {
                                        <img class="img-fluid rounded-start" src="~/images/Icon.jpg" />
                                    }
                                </div>
                                <div class="col-md-10">
                                    <div class="card-body">
                                        <h5 class="detail-title">@product.Name</h5>
                                        <div class="row">
                                            <div class="col-md-6">
                                                <p class="card-text"><strong>Alcoholhoudend:</strong></p>
                                            </div>
                                            <div class="col-md-6">
                                                <p class="card-text">@((product.IsAlcoholic) ? "Ja" : "Nee")</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                    }
                    else
                    {
                        <div class="row detail-row mb-1">
                            <div class="col-md-2">
                                <p> geen producten</p>
                            </div>
                            <div class="col-md-10">
                                <div class="card-body">
                                    <div class="row">
                                    </div>
                                </div>
                            </div>
                        </div>

                    }
                    </div>

            </div>
        </div>
    </div>
</div>
