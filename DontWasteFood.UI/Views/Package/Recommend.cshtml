@model List<PackageViewModel>
@{
    ViewData["Title"] = "Aanbevolen maaltijdpakketten";
}

<partial name="_StudentMenu" />

<div class="container mt-5 pt-5">
    <div class="card mb-2 mt-2 shadow">
        <div class="card-header text-center">
            <h2>Aangeboden maaltijdpakketten</h2>
        </div>

        <div class="card-body">
            <div class="row">
                <div class="d-flex justify-content-end mb-3">
                    <a type="button" class="btn" asp-controller="Student" asp-action="Overview">Terug</a>
                </div>
                <div class="col-md-3">
                    <div>
                        <form>
                            <h5>Locatie</h5>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="location" value="Breda" id="locationBreda" />
                                <label class="form-check-label" for="locationBreda">Breda</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="location" value="Den Bosch" id="locationDenBosch" />
                                <label class="form-check-label" for="locationDenBosch">Den Bosch</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="location" value="Tilburg" id="locationTilburg" />
                                <label class="form-check-label" for="locationTilburg">Tilburg</label>
                            </div>

                            <h5 class="mt-3">Maaltijdtype</h5>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="mealType" value="Brood" id="mealTypeBrood" />
                                <label class="form-check-label" for="mealTypeBrood">Brood</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="mealType" value="Warm" id="mealTypeWarm" />
                                <label class="form-check-label" for="mealTypeWarm">Warme Maaltijd</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="mealType" value="Drank" id="mealTypeDrank" />
                                <label class="form-check-label" for="mealTypeDrank">Drank</label>
                            </div>

                            <button type="submit" class="btn mt-3">Filteren</button>
                        </form>
                    </div>
                </div>

                <div class="col-md-9">
                    @if(Model == null || Model.Count == 0) 
                    {
                        <div class="alert alert-info" role="alert">
                            Momenteel worden er nog geen maaltijdpakketten aangeboden. Probeer het later opnieuw!
                        </div>
                    }
                    else 
                    {
                        @foreach(var package in Model) 
                        {
                            <div class="box me-auto ms-auto card-title position-relative">
                                <div class="row detail-row mt-2">
                                    <div class="col-6 detail-label"><h2>Naam:</h2></div>
                                    <div class="col-6 detail-value text-right"><h2>@package.Name</h2></div>
                                </div>
                            </div>

                            <div class="details-box mx-auto">
                                <div class="row detail-row mb-1">
                                    <div class="col-6 detail-label"><strong>Datum:</strong></div>
                                    <div class="col-6 detail-value"><p>@package.DateOfPickUp.ToString("dd-MM-yyyy")</p></div>
                                </div>
                                <div class="row detail-row mb-1">
                                    <div class="col-6 detail-label"><strong>Maaltijdtype:</strong></div>
                                    <div class="col-6 detail-value"><p>@package.MealType</p></div>
                                </div>
                                <div class="row detail-row mb-1">
                                    <div class="col-6 detail-label"><strong>Locatie:</strong></div>
                                    <div class="col-6 detail-value"><p>@package.Location</p></div>
                                </div>
                                <div class="row detail-row mb-1">
                                    <div class="col-6 detail-label"><strong>Stad:</strong></div>
                                    <div class="col-6 detail-value"><p>@package.City</p></div>
                                </div>
                                <div class="row detail-row mb-1">
                                    <div class="col-6 detail-label"><strong>18+ indicatie:</strong></div>
                                    <div class="col-6 detail-value">
                                        <p>@(package.Is18Plus ? "Ja" : "Nee")</p>
                                    </div>
                                </div>
                            </div>

                            <div class="box mx-auto">
                                <div class="row detail-row mt-2">
                                    <div class="col-6 detail-label"><h3>Prijs:</h3></div>
                                    <div class="col-6 detail-value text-right"><h3>€ @package.Price</h3></div>
                                </div>
                            </div>


                            <div class="box mx-auto">
                                <div class="row detail-row justify-content-end align-content-end mb-5 me-1">
                                    <a type="button" class="btn" asp-controller="Package" asp-action="Details" asp-route-id="">Details</a>

                                </div>
                            </div>

                        }


                    }
                </div>
            </div>
        </div>
    </div>
</div>